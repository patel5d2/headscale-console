# Copy to .env and edit. docker compose reads it automatically.

# Your Headscale server's public URL (server_url in its config). Leave empty to
# type the URL on the login page instead (docker-compose.full.yml requires it).
HEADSCALE_URL=

# docker-compose.full.yml only (both optional):
# The console's address as devices reach it, for device logs, e.g.
# https://console.example.com or http://100.64.0.5:8090 (its tailnet address).
PUBLIC_URL=
# An API key turns automatic log collection on at start-up:
#   headscale apikeys create --expiration 1y
COLLECTOR_API_KEY=

# Time zone for the audit log and container logs.
TZ=UTC

# Image tag (latest, a version like 2.0.0, or sha-<commit>). docker-compose.full.yml
# adds "-host" to it.
HEADSCALE_CONSOLE_TAG=latest
